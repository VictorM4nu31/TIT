<?xml version="1.0"?>
<ruleset name="tranzit-pure-php" xmlns="http://pmd.sf.net/ruleset/2.0.0">
  <description>Umbrales duros Tranzit: complejidad, tamano, acoplamiento</description>
  <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
    <properties><property name="max" value="5"/></properties>
  </rule>
  <rule ref="rulesets/codesize.xml/NPathComplexity">
    <properties><property name="max" value="50"/></properties>
  </rule>
  <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
    <properties><property name="max" value="30"/></properties>
  </rule>
  <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
    <properties><property name="max" value="4"/></properties>
  </rule>
  <rule ref="rulesets/codesize.xml/TooManyMethods">
    <properties><property name="max" value="10"/></properties>
  </rule>
  <rule ref="rulesets/coupling.xml/CouplingBetweenObjects">
    <properties><property name="max" value="6"/></properties>
  </rule>
</ruleset>

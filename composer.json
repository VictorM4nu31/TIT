{
  "name": "tephe/tranzit",
  "description": "Sistema de Control de Transporte Publico TEPHE - PHP puro",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-mysqli": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.11",
    "vimeo/psalm": "^5.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "squizlabs/php_codesniffer": "^3.9",
    "phpmd/phpmd": "^2.15",
    "infection/infection": "^0.27"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "stan": "phpstan analyse -c phpstan.neon",
    "psalm": "psalm --no-cache",
    "test": "phpunit -c phpunit.xml",
    "mut": "infection -c infection.json --min-msi=75 --min-covered-msi=85",
    "md": "phpmd admi,chec,registr_pers,registr_combis,reporte.php text phpmd.xml",
    "qa": ["@cs:check", "@stan", "@psalm", "@test"]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  }
}
